{
  "name": "foundations-codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 1 },
  "postCreateCommand": "pip install -r requirements.txt && chmod +x .devcontainer/bin/*",
  "remoteEnv": {
      "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/.devcontainer/bin"
    },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "-github.copilot", "-github.copilot-chat"],
      "settings": {
        "chat.disableAIFeatures": true,
        "github.copilot.enable": { "*": false },
        "github.copilot.editor.enableAutoCompletions": false,
        "github.copilot.inlineSuggest.enable": false,
        "git.enabled": false,
        "git.decorations.enabled": false,
        "scm.diffDecorations": "none",
        "git.openRepositoryInParentFolders": "never"
      }
    }
  }
}
